{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "tracepunk",
	"main": "workers/index.ts",
	"compatibility_date": "2026-10-23",
	"assets": {
		"directory": "./build",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*"]
	},
	"minify": true,
	"observability": {
		"enabled": false
	},
	"ratelimits": [
		{
			"name": "USERNAME_RATE_LIMITER",
			"namespace_id": "17832001",
			"simple": {
				"limit": 1200,
				"period": 60
			}
		},
		{
			"name": "API_RATE_LIMITER",
			"namespace_id": "17832002",
			"simple": {
				"limit": 30,
				"period": 60
			}
		}
	]
}
